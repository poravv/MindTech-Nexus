<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs JSON a stdout (Promtail -> Loki). Defensa en profundidad: aunque el código nunca loguea secretos,
  cualquier valor con forma de token, cabecera sensible o campo secreto se enmascara (spec §5.3).
  Ojo: logback separa <value> por comas; dentro de las regex la coma y la llave de cierre se escriben \x2C y \x7D.
-->
<configuration>
    <springProperty scope="context" name="app" source="spring.application.name"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <defaultMask>***</defaultMask>
                <paths>password,secret,clientSecret,client_secret,apiKey,secretKey,accessKey,credentials,authorization,refreshToken,accessToken</paths>
                <valueMask>
                    <value>(?i)\b(bearer|basic)\s+[A-Za-z0-9._~+/=-]+</value>
                    <mask>$1 ***</mask>
                </valueMask>
                <valueMask>
                    <value>eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+</value>
                    <mask>***</mask>
                </valueMask>
                <valueMask>
                    <value>(?i)(authorization|x-secret-key|x-access-key|x-signature|api[_-]?key|client[_-]?secret|secret[_-]?key|secret|password|credentials)(["']?\s*[:=]\s*["']?)[^"'\s\x7D\x2C]+</value>
                    <mask>$1$2***</mask>
                </valueMask>
            </jsonGeneratorDecorator>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>

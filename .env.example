# Copiar a .env (gitignored) y completar. Mismos nombres que el Secret de K8s nexus-api-secrets.
NEXUS_DB_NAME=nexus
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=
# openssl rand -base64 64   (HS256, mínimo 256 bits)
NEXUS_JWT_SIGNING_KEY=
# openssl rand -base64 32   (AES-256-GCM, exactamente 32 bytes)
NEXUS_MASTER_KEY=
NEXUS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Mínimo 12 caracteres; se exige cambiarla en el primer login.
NEXUS_BOOTSTRAP_ADMIN_PASSWORD=
